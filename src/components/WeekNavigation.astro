---
import type { WeeklyEdition } from '../lib/domain/types';
interface Props {
  editions: WeeklyEdition[];
  current: WeeklyEdition;
  isCurrentPage?: boolean;
}
const { editions, current, isCurrentPage = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const index = editions.findIndex((edition) => edition.editionId === current.editionId);
const previous = index > 0 ? editions[index - 1] : null;
const next = index >= 0 && index < editions.length - 1 ? editions[index + 1] : null;
---

<nav class:list={['week-nav', { 'week-nav--history': !isCurrentPage }]} aria-label="Ranking weeks">
  {previous ? (
    <a class="week-nav-previous" href={`${base}/weeks/${previous.week.number}/`}>
      ← Week {previous.week.number}
    </a>
  ) : (
    <span class="week-nav-previous">First edition</span>
  )}
  <a class="week-nav-current" href={`${base}/`}>
    Current
  </a>
  <details class="all-weeks">
    <summary>All weeks</summary>
    <ul>
      {editions.map((edition) => (
        <li>
          <a
            href={`${base}/weeks/${edition.week.number}/`}
            aria-current={edition.editionId === current.editionId ? 'page' : undefined}
          >
            Week {edition.week.number}
          </a>
        </li>
      ))}
    </ul>
  </details>
  {next ? (
    <a class="week-nav-next" href={`${base}/weeks/${next.week.number}/`}>
      Week {next.week.number} →
    </a>
  ) : (
    <span class="week-nav-next">Latest edition</span>
  )}
</nav>
