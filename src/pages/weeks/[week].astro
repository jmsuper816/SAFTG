---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RankingCard from '../../components/RankingCard.astro';
import WeekNavigation from '../../components/WeekNavigation.astro';
import BadgeSummary from '../../components/BadgeSummary.astro';
import { loadEditions } from '../../lib/editions/load';
import { loadPublishedRecaps } from '../../lib/recaps/load';
export const getStaticPaths = (async () =>
  (await loadEditions()).map((edition) => ({
    params: { week: String(edition.week.number) },
    props: { edition },
  }))) satisfies GetStaticPaths;
const { edition } = Astro.props;
const editions = await loadEditions();
const recaps = await loadPublishedRecaps(editions);
const recap = recaps.get(edition.editionId);
---

<BaseLayout title="Sundays Are For The Girls Weekly Roundup">
  <header class="hero">
    <p class="eyebrow">Week {edition.week.number} · Historical</p>
    <h1 id="roundup-title" tabindex="-1">
      Sundays Are For The Girls Weekly Roundup
    </h1>
    <p>
      <time datetime={edition.publishedAt}>
        {new Date(edition.publishedAt).toLocaleDateString('en-US', {
          dateStyle: 'long',
          timeZone: edition.league.timezone,
        })}
      </time>
    </p>
    <hr class="recap-divider" aria-hidden="true" />
    <div class="weekly-recap" role="region" aria-label="Weekly recap">
      {recap?.paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>
  </header>
  <WeekNavigation editions={editions} current={edition} />
  <BadgeSummary edition={edition} />
  <section class="rankings" aria-label={`Week ${edition.week.number} power rankings`}>
    <h2 class="eyebrow rankings-heading">POWER RANKING</h2>
    {edition.entries.map((entry) => (
      <RankingCard
        entry={entry}
        awards={edition.badges.filter((award) => award.teamId === entry.teamId)}
        week={edition.week.number}
      />
    ))}
    <a class="button back-to-top" href="#roundup-title">
      Back to top
    </a>
  </section>
</BaseLayout>
