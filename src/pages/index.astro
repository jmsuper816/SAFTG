---
import BaseLayout from '../layouts/BaseLayout.astro';
import RankingCard from '../components/RankingCard.astro';
import WeekNavigation from '../components/WeekNavigation.astro';
import BadgeSummary from '../components/BadgeSummary.astro';
import { latestEdition, loadEditions } from '../lib/editions/load';
import { rankMovement } from '../lib/editions/movement';
import { loadPublishedRecaps } from '../lib/recaps/load';
import type { PublishedRecap } from '../lib/recaps/types';
const editions = await loadEditions();
const edition = latestEdition(editions);
const previousEdition = edition?.previousEditionId
  ? (editions.find((candidate) => candidate.editionId === edition.previousEditionId) ?? null)
  : null;
const recaps = editions.length
  ? await loadPublishedRecaps(editions)
  : new Map<string, PublishedRecap>();
const recap = edition ? recaps.get(edition.editionId) : undefined;
---

<BaseLayout title="Sundays Are For The Girls Weekly Roundup">
  {edition ? (
    <>
      <header class="hero">
        <p class="eyebrow">Week {edition.week.number} · Current</p>
        <h1 id="roundup-title" tabindex="-1">
          Sundays Are For The Girls Weekly Roundup
        </h1>
        <p>
          <time datetime={edition.publishedAt}>
            {new Date(edition.publishedAt).toLocaleDateString('en-US', {
              dateStyle: 'long',
              timeZone: edition.league.timezone,
            })}
          </time>
        </p>
        <hr class="recap-divider" aria-hidden="true" />
        <div class="weekly-recap" role="region" aria-label="Weekly recap">
          {recap?.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      </header>
      <WeekNavigation editions={editions} current={edition} isCurrentPage />
      <BadgeSummary edition={edition} />
      <section class="rankings" aria-label="Current power rankings">
        <h2 class="eyebrow rankings-heading">POWER RANKING</h2>
        {edition.entries.map((entry) => (
          <RankingCard
            entry={{
              ...entry,
              ...(previousEdition ? rankMovement(previousEdition, entry.teamId, entry.rank) : {}),
            }}
            awards={edition.badges.filter((award) => award.teamId === entry.teamId)}
            week={edition.week.number}
          />
        ))}
        <a class="button back-to-top" href="#roundup-title">
          Back to top
        </a>
      </section>
    </>
  ) : (
    <section class="empty">
      <h1>Rankings are warming up</h1>
      <p>The commissioner’s first complete Tuesday edition has not been published yet.</p>
    </section>
  )}
</BaseLayout>
