---
import '../styles/global.css';
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Weekly fantasy football power rankings and team badges.' } =
  Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to rankings
    </a>
    <header class="site-header">
      <a href={`${base}/`} class="brand">
        Tuesday Power
      </a>
      <span>Commissioner calls. League chaos.</span>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer>Built for fun. Rankings are commissioner-authored; scores come from ESPN.</footer>
  </body>
</html>
