---
import '../styles/global.css';
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Weekly fantasy football power rankings and team badges.' } =
  Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to rankings
    </a>
    <main id="main">
      <slot />
    </main>
  </body>
</html>
