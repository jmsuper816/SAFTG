{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saftg.example/contracts/commissioner-ranking.schema.json",
  "title": "Commissioner Ranking Submission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "leagueId",
    "season",
    "week",
    "commissioner",
    "submittedAt",
    "rankings"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "leagueId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "season": { "type": "integer", "minimum": 2020, "maximum": 2100 },
    "week": { "type": "integer", "minimum": 1, "maximum": 25 },
    "commissioner": { "type": "string", "minLength": 1, "maxLength": 80 },
    "submittedAt": { "type": "string", "format": "date-time" },
    "rankings": {
      "type": "array",
      "minItems": 2,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["teamId", "rank", "explanation"],
        "properties": {
          "teamId": { "type": "string", "minLength": 1, "maxLength": 64 },
          "rank": { "type": "integer", "minimum": 1, "maximum": 20 },
          "explanation": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    }
  }
}
